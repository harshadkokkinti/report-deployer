# GitHub — create a Personal Access Token with repo scope
# https://github.com/settings/tokens/new
GITHUB_TOKEN=ghp_your_token_here
GITHUB_OWNER=your-github-username
GITHUB_REPO=report-deployer

# The public URL of your deployment (no trailing slash)
SITE_URL=https://your-project.vercel.app

# Admin dashboard credentials (required)
ADMIN_USER=admin
ADMIN_PASS=change-me-in-production

# Google Analytics (optional — defaults to G-QTPDLYM4RW)
GA_MEASUREMENT_ID=G-QTPDLYM4RW

# Secret path for the admin dashboard — set to a hard-to-guess string (e.g. a random slug)
# Access: https://your-domain.com/<ADMIN_PATH>
ADMIN_PATH=your-secret-path

# Google Sheet URL to display in the admin dashboard (also used to extract Sheet ID)
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your-sheet-id/edit

# Google Service Account credentials (JSON string) — needed to write URLs back to the sheet
# 1. Go to Google Cloud Console → APIs & Services → Enable "Google Sheets API"
# 2. IAM & Admin → Service Accounts → Create → Create Key (JSON) → Download
# 3. Share the Google Sheet with the service account email (Editor access)
# 4. Paste the entire JSON file contents as the value below (keep it on one line or use Vercel's env UI)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\\n...\\n-----END RSA PRIVATE KEY-----\\n","client_email":"...@....iam.gserviceaccount.com",...}

# Optional overrides (defaults work for most cases)
# GOOGLE_SHEET_ID=1zk07zkLNrTzU2sp7yKgdp3u581x9QcyrKvYcwezYPJ8
# GOOGLE_SHEET_NAME=Sheet1

# Local dev only
PORT=3000

# ── Complaint Reports dashboard (/complaint-reports) ─────────────────────────
# Same Supabase project olly-backend already uses — copy these two values
# from olly-backend's .env. The service role key bypasses RLS; it must never
# be exposed to the browser (it's only read here, server-side).
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Random secret used to sign the cr_session cookie (JWT). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CR_SESSION_SECRET=<random-64-char-hex-string>

# n8n — never sent to the browser. The dashboard's frontend has no knowledge
# of these; only api/complaintReports.js reads them.
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/complaint-report
# Shared secret n8n must send back as the X-Callback-Secret header when it
# POSTs to /complaint-reports/api/reports/:id/callback on completion.
N8N_CALLBACK_SECRET=<random-secret-shared-with-n8n>

# Run once to create the first admin (see scripts/seed-cr-admin.js):
#   node scripts/seed-cr-admin.js "Nikhil Chavda" nikhil@askolly.io "a-strong-password" admin
