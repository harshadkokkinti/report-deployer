<style>
.bottom-bar {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
}


/* Glass Morphism Card */
.glass-card {
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px) saturate(180%);
    -webkit-backdrop-filter: blur(12px) saturate(180%);
    border-radius: 22px;
    padding: 14px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    border: 1px solid rgba(255,255,255,0.25);
    width: max-content;
}

/* Discount Tag */
.discount-tag {
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 8px;
}

/* Order Button (Gold Premium Look) */
.order-btn {
    background: #014857;
    color: white;
    padding: 12px 26px;
    border-radius: 30px;
    font-size: 17px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(0,0,0,0.25);
    transition: 0.2s ease;
}

.order-btn:hover {
    transform: scale(1.05);
    background: linear-gradient(135deg, #f0c97a, #ffe4ac);
}

/* Mobile */
@media(max-width: 480px) {
    .glass-card {
        padding: 10px 16px;
    }
    .order-btn {
        font-size: 15px;
        padding: 10px 22px;
    }
    .discount-tag {
        font-size: 14px;
    }
}

/* Mobile (Normal Small Devices) */
@media (max-width: 480px) {
    .glass-card {
        padding: 10px 16px;
        max-width: 366px;
    }
}

/* Very Small Devices (320px – iPhone SE, old Androids) */
@media (max-width: 360px) {
    .glass-card {
        padding: 8px 12px;
        max-width: 300px;
    }
        .order-btn {
        font-size: 12px;
        padding: 10px 22px;
    }
    .discount-tag {
        font-size: 12px;
    }
}

/* Ultra Small Devices (<300px width phones, rare devices) */
@media (max-width: 300px) {
    .glass-card {
        padding: 6px 10px;
        max-width: 260px;
    }
        .order-btn {
        font-size: 12px;
        padding: 10px 22px;
    }
    .discount-tag {
        font-size: 11px;
    }
}

</style>


</head>




